ITAD_API_KEY=your_api_key_here

# IGDB (via Twitch Developer credentials) — optional, enables rating sort
# Register at https://dev.twitch.tv/console and create an application
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Redis connection URL (required for caching)
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# PostgreSQL connection URL (required for persistent data: title mappings, controller support, IGDB data)
# Matches the docker-compose.yml defaults — change for production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/steamuready

# Set to true to skip the Steam controller support warm-up on startup.
# Useful locally when running the seed generation script to avoid racing Steam's rate limit.
# SKIP_CTRL_WARM=true

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Sender address for verification/reset/alert emails — must be a verified SES identity.
# Use a no-reply address, not a monitored inbox; replies are routed via Reply-To instead.
SES_FROM_EMAIL=no-reply@steamuready.com

# Set to true to log composed emails to the console instead of calling SES
# (local dev/tests can't easily use production SES access).
EMAIL_DRY_RUN=true

# Secret used to sign one-click unsubscribe links (HMAC; not stored in the DB). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Base URL used to build links in emails sent from the background price-alert job
# (which has no HTTP request to derive one from). Set to wherever this app is actually served.
APP_BASE_URL=http://localhost:3000
